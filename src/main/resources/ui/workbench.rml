<rml>
<head><title>Doctrine</title><link type="text/rcss" href="workbench.rcss"/></head>
<body>
<div id="workbench" class="window">
  <div class="console">
    <div class="masthead"><div class="identity"><span class="brand-symbol"><span/><span/><span/></span><span class="wordmark">doctrine</span></div><button id="close-button" action="close" class="exit"><span>Back to game</span><span id="key-toggle" class="key">F8</span><span class="close-symbol">×</span></button></div>
    <div id="main-content" class="main">
      <div id="view-recovery">
        <div class="recovery-main">
          <div class="dial" id="recovery-dial"><div class="dial-track"/><div class="dial-center"><span id="recovery-count" class="dial-value">0</span><span class="dial-caption">of 12 drops</span></div><span id="probe-0" class="probe" style="left: 102.50dp; top: 0.00dp; transform: rotate(0deg);"/>
<span class="dial-tick" style="left: 114.03dp; top: 6.53dp; transform: rotate(6deg);"/>
<span class="dial-tick" style="left: 123.96dp; top: 8.10dp; transform: rotate(12deg);"/>
<span class="dial-tick" style="left: 133.67dp; top: 10.70dp; transform: rotate(18deg);"/>
<span class="dial-tick" style="left: 143.05dp; top: 14.30dp; transform: rotate(24deg);"/>
<span id="probe-1" class="probe" style="left: 150.50dp; top: 12.86dp; transform: rotate(30deg);"/>
<span class="dial-tick" style="left: 160.43dp; top: 24.33dp; transform: rotate(36deg);"/>
<span class="dial-tick" style="left: 168.24dp; top: 30.66dp; transform: rotate(42deg);"/>
<span class="dial-tick" style="left: 175.34dp; top: 37.76dp; transform: rotate(48deg);"/>
<span class="dial-tick" style="left: 181.67dp; top: 45.57dp; transform: rotate(54deg);"/>
<span id="probe-2" class="probe" style="left: 185.64dp; top: 48.00dp; transform: rotate(60deg);"/>
<span class="dial-tick" style="left: 191.70dp; top: 62.95dp; transform: rotate(66deg);"/>
<span class="dial-tick" style="left: 195.30dp; top: 72.33dp; transform: rotate(72deg);"/>
<span class="dial-tick" style="left: 197.90dp; top: 82.04dp; transform: rotate(78deg);"/>
<span class="dial-tick" style="left: 199.47dp; top: 91.97dp; transform: rotate(84deg);"/>
<span id="probe-3" class="probe" style="left: 198.50dp; top: 96.00dp; transform: rotate(90deg);"/>
<span class="dial-tick" style="left: 199.47dp; top: 112.03dp; transform: rotate(96deg);"/>
<span class="dial-tick" style="left: 197.90dp; top: 121.96dp; transform: rotate(102deg);"/>
<span class="dial-tick" style="left: 195.30dp; top: 131.67dp; transform: rotate(108deg);"/>
<span class="dial-tick" style="left: 191.70dp; top: 141.05dp; transform: rotate(114deg);"/>
<span id="probe-4" class="probe" style="left: 185.64dp; top: 144.00dp; transform: rotate(120deg);"/>
<span class="dial-tick" style="left: 181.67dp; top: 158.43dp; transform: rotate(126deg);"/>
<span class="dial-tick" style="left: 175.34dp; top: 166.24dp; transform: rotate(132deg);"/>
<span class="dial-tick" style="left: 168.24dp; top: 173.34dp; transform: rotate(138deg);"/>
<span class="dial-tick" style="left: 160.43dp; top: 179.67dp; transform: rotate(144deg);"/>
<span id="probe-5" class="probe" style="left: 150.50dp; top: 179.14dp; transform: rotate(150deg);"/>
<span class="dial-tick" style="left: 143.05dp; top: 189.70dp; transform: rotate(156deg);"/>
<span class="dial-tick" style="left: 133.67dp; top: 193.30dp; transform: rotate(162deg);"/>
<span class="dial-tick" style="left: 123.96dp; top: 195.90dp; transform: rotate(168deg);"/>
<span class="dial-tick" style="left: 114.03dp; top: 197.47dp; transform: rotate(174deg);"/>
<span id="probe-6" class="probe" style="left: 102.50dp; top: 192.00dp; transform: rotate(180deg);"/>
<span class="dial-tick" style="left: 93.97dp; top: 197.47dp; transform: rotate(186deg);"/>
<span class="dial-tick" style="left: 84.04dp; top: 195.90dp; transform: rotate(192deg);"/>
<span class="dial-tick" style="left: 74.33dp; top: 193.30dp; transform: rotate(198deg);"/>
<span class="dial-tick" style="left: 64.95dp; top: 189.70dp; transform: rotate(204deg);"/>
<span id="probe-7" class="probe" style="left: 54.50dp; top: 179.14dp; transform: rotate(210deg);"/>
<span class="dial-tick" style="left: 47.57dp; top: 179.67dp; transform: rotate(216deg);"/>
<span class="dial-tick" style="left: 39.76dp; top: 173.34dp; transform: rotate(222deg);"/>
<span class="dial-tick" style="left: 32.66dp; top: 166.24dp; transform: rotate(228deg);"/>
<span class="dial-tick" style="left: 26.33dp; top: 158.43dp; transform: rotate(234deg);"/>
<span id="probe-8" class="probe" style="left: 19.36dp; top: 144.00dp; transform: rotate(240deg);"/>
<span class="dial-tick" style="left: 16.30dp; top: 141.05dp; transform: rotate(246deg);"/>
<span class="dial-tick" style="left: 12.70dp; top: 131.67dp; transform: rotate(252deg);"/>
<span class="dial-tick" style="left: 10.10dp; top: 121.96dp; transform: rotate(258deg);"/>
<span class="dial-tick" style="left: 8.53dp; top: 112.03dp; transform: rotate(264deg);"/>
<span id="probe-9" class="probe" style="left: 6.50dp; top: 96.00dp; transform: rotate(270deg);"/>
<span class="dial-tick" style="left: 8.53dp; top: 91.97dp; transform: rotate(276deg);"/>
<span class="dial-tick" style="left: 10.10dp; top: 82.04dp; transform: rotate(282deg);"/>
<span class="dial-tick" style="left: 12.70dp; top: 72.33dp; transform: rotate(288deg);"/>
<span class="dial-tick" style="left: 16.30dp; top: 62.95dp; transform: rotate(294deg);"/>
<span id="probe-10" class="probe validation" style="left: 19.36dp; top: 48.00dp; transform: rotate(300deg);"/>
<span class="dial-tick" style="left: 26.33dp; top: 45.57dp; transform: rotate(306deg);"/>
<span class="dial-tick" style="left: 32.66dp; top: 37.76dp; transform: rotate(312deg);"/>
<span class="dial-tick" style="left: 39.76dp; top: 30.66dp; transform: rotate(318deg);"/>
<span class="dial-tick" style="left: 47.57dp; top: 24.33dp; transform: rotate(324deg);"/>
<span id="probe-11" class="probe validation" style="left: 54.50dp; top: 12.86dp; transform: rotate(330deg);"/>
<span class="dial-tick" style="left: 64.95dp; top: 14.30dp; transform: rotate(336deg);"/>
<span class="dial-tick" style="left: 74.33dp; top: 10.70dp; transform: rotate(342deg);"/>
<span class="dial-tick" style="left: 84.04dp; top: 8.10dp; transform: rotate(348deg);"/>
<span class="dial-tick" style="left: 93.97dp; top: 6.53dp; transform: rotate(354deg);"/></div>
          <div class="recovery-copy"><h1>Seed<br/>recovery</h1><p>Recover the player seed<br/>from 12 controlled item drops.</p><button id="start-recovery" action="recover" class="primary">Recover seed<span id="key-recover" class="key">F7</span></button><div class="recovery-secondary"><span>Returns to game</span><button id="cancel-recovery" action="cancel" class="text-button">Cancel</button></div></div>
        </div>
        <div class="recovery-feedback"><span class="signal"/><p id="recovery-status">Requires 12 stackable, unenchanted items.</p></div>
        <div class="setup-note"><p>Remain still on clear, dry ground.</p><span>View and selected slot restored.</span></div>
      </div>
      <div id="view-offers" class="hidden">
        <div class="view-heading"><h1>Table offers</h1><p id="status">Insert an unenchanted item into the table.</p></div>
        <div class="offers"><div class="offer"><span class="offer-index">1</span><div><span id="cost0" class="offer-cost">First offer</span><p id="offer0">Insert an unenchanted item.</p></div></div><div class="offer"><span class="offer-index">2</span><div><span id="cost1" class="offer-cost">Second offer</span><p id="offer1">Insert an unenchanted item.</p></div></div><div class="offer"><span class="offer-index">3</span><div><span id="cost2" class="offer-cost">Third offer</span><p id="offer2">Insert an unenchanted item.</p></div></div></div>
        <div class="action-row"><button id="read-table" action="observe" class="primary">Read table<span id="key-observe" class="key">F6</span></button><span class="hint">Change items to reduce seed candidates.</span></div>
        <p class="fine-print">On vanilla servers, two consecutive table seeds can recover the player seed.</p>
      </div>
      <div id="view-planner" class="hidden">
        <div class="view-heading heading-row"><div><h1>Enchantment planner</h1><p>Set the target item and required enchantments.</p></div><button id="reopen-route" action="tab:route" class="text-button">View route</button></div>
        <div class="entry"><label for="item">Item</label><input id="item" type="text" value="minecraft:diamond_pickaxe" maxlength="128"/></div>
        <div class="entry"><label for="wanted">Enchantments</label><input id="wanted" type="text" value="efficiency:4,unbreaking:3" maxlength="512"/></div>
        <p class="field-help">Separate enchantments with commas. Levels are minimum requirements.</p>
        <div class="limits"><div><label for="max-drops">Drop limit</label><input id="max-drops" type="text" value="2048" maxlength="6"/></div><div><label for="levels">Available levels</label><input id="levels" type="text" value="30" maxlength="3"/></div></div>
        <div class="action-row"><button id="search-route" action="search" class="primary">Find route<span class="forward-symbol"/></button><button action="cancel" class="text-button">Cancel</button></div><p class="fine-print">Searches individual table offers. Excludes anvil combinations.</p>
      </div>
      <div id="view-route" class="hidden">
        <div class="view-heading heading-row"><div><h1>Enchantment route</h1><p>Steps for the selected enchantment.</p></div><button id="edit-plan" action="tab:planner" class="text-button">Edit target</button></div>
        <div class="route-output"><span class="route-symbol"/><p id="route">Recover a player seed or table seed before searching.</p></div>
        <div class="action-row"><button id="drop-plan" action="drop" class="primary"><span id="drop-label">Run planned drops</span><span id="key-drop" class="key">G</span></button><button id="copy-route" action="copy" class="text-button">Copy route</button><button action="cancel" class="text-button">Cancel</button></div><p id="drop-status" class="field-help">Items are picked up and reused automatically.</p>
      </div>
      <div id="view-session" class="hidden">
        <div class="session-top"><div><span class="overline">Player seed</span><div id="player-seed" class="seed-value">Not recovered</div></div><span id="player-state" class="state-badge">Awaiting recovery</span></div><p id="tracking" class="field-help">Recover from item drops or two consecutive table seeds.</p>
        <div class="session-details"><div class="data-row"><span>Table seed</span><span id="seed">Unknown</span></div><div class="data-row"><span>Candidates</span><span id="candidates">No observation</span></div><div class="data-row"><span>Bookshelves</span><span id="shelves">Not detected</span></div><div class="data-row"><span>Server</span><span id="server-mode">Detecting server</span></div></div>
        <div class="session-actions"><button id="show-shortcuts" action="tab:shortcuts" class="secondary">Shortcuts</button><button id="reset-session" action="reset" class="text-button">Reset session</button></div><p class="fine-print">Tracking resets after actions that may change the player seed.</p>
      </div>
      <div id="view-shortcuts" class="hidden">
        <div class="view-heading heading-row"><div><h1>Keyboard shortcuts</h1><p>Key bindings for common actions.</p></div><button action="tab:session" class="text-button">Back</button></div>
        <button action="drop" class="shortcut"><span>Run planned drops</span><span id="key-drop-sidebar" class="key">G</span></button><button action="tab:planner" class="shortcut"><span>Open planner</span><span id="key-planner" class="key">F9</span></button><button action="cancel" class="shortcut"><span>Cancel task</span><span id="key-cancel" class="key">F10</span></button><button id="customize-controls" action="controls" class="primary customize">Edit key bindings</button><p class="field-help">Recovery and table keys appear beside their buttons.</p>
      </div>
    </div>
    <div class="statusbar"><span id="activity">Ready to observe</span><span id="timing">Waiting for a table</span></div>
  </div>
  <div class="dock"><button id="tab-recovery" action="tab:recovery" class="nav selected"><span class="nav-icon recover-icon"/><span>Recover</span></button><button id="tab-offers" action="tab:offers" class="nav"><span class="nav-icon offers-icon"><span/><span/><span/></span><span>Offers</span></button><button id="tab-planner" action="tab:planner" class="nav"><span class="nav-icon planner-icon"/><span>Plan</span></button><button id="tab-session" action="tab:session" class="nav"><span class="nav-icon session-icon"><span/><span/></span><span>Session</span></button></div>
</div>
</body>
</rml>
